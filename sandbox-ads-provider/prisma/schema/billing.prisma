/// Wallet top-up ("Add funds" in Google Ads manual payments).
model Payment {
  id            String            @id @default(cuid())
  customerId    String
  amountMicros  BigInt
  method        PaymentMethodType
  cardBrand     String?
  cardLast4     String?
  status        PaymentStatus
  declineReason String?
  /// Bank transfers stay PENDING until this moment.
  settlesAt     DateTime?
  settledAt     DateTime?
  createdAt     DateTime          @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status, settlesAt])
  @@map("payments")
}

/// Ad spend debited from the wallet, one row per account per UTC day.
model DailyCharge {
  customerId   String
  date         DateTime @db.Date
  amountMicros BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, date])
  @@map("daily_charges")
}
