/// Responsive search ad. Any content change sends it back to policy review.
model AdGroupAd {
  id             BigInt               @id @default(autoincrement())
  adGroupId      BigInt
  headlines      String[]
  descriptions   String[]
  finalUrls      String[]
  path1          String?
  path2          String?
  status         EntityStatus         @default(ENABLED)
  reviewStatus   PolicyReviewStatus   @default(REVIEW_IN_PROGRESS)
  approvalStatus PolicyApprovalStatus @default(UNKNOWN)
  policyTopics   String[]
  submittedAt    DateTime             @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  adGroup AdGroup @relation(fields: [adGroupId], references: [id], onDelete: Cascade)

  @@index([adGroupId])
  @@index([reviewStatus, submittedAt])
  @@map("ad_group_ads")
}
