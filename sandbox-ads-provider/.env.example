# Postgres from the repo root docker-compose.yml (database created by docker/postgres/init)
DATABASE_URL="postgresql://ads_sandbox:ads_sandbox@localhost:5434/ads_sandbox"

# Stand-ins for the OAuth access token (Authorization: Bearer …) and the Google Ads developer-token header
SANDBOX_API_TOKEN="sandbox-dev-token"
SANDBOX_DEVELOPER_TOKEN="sandbox-developer-token"

PORT=4000
# Origin browsers use for gtm.js, gtag.js, the conversion pixel and the search page
PUBLIC_URL="http://localhost:4000"

# How long ads stay in policy review
AD_REVIEW_DELAY_SECONDS=60
# How long a bank transfer top-up stays pending
BANK_TRANSFER_SETTLE_SECONDS=300
# How often simulated delivery is accrued in the background (it is also accrued on every API call)
ACCRUAL_INTERVAL_SECONDS=60
# Simulated traffic speed-up for demos (60 = an hour of traffic per minute; daily budgets still cap each day)
DELIVERY_SPEED=1
