# Postgres from the repo root docker-compose.yml (database created by docker/postgres/init)
DATABASE_URL="postgresql://ads_sandbox:ads_sandbox@localhost:5434/ads_sandbox"

# Bearer token ads-manager sends in the Authorization header
SANDBOX_API_TOKEN="sandbox-dev-token"

PORT=4000

# How long an ad stays UNDER_REVIEW before the policy decision lands
AD_REVIEW_DELAY_SECONDS=60

# How often delivery is accrued in the background (it is also accrued on every read)
ACCRUAL_INTERVAL_SECONDS=60
